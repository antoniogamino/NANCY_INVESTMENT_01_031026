# ───────── Nancy Investment Intelligence — configuration ─────────
# Copy to .env (project root) and adjust. Everything works offline with the defaults.

# Database (SQLite file under backend/data by default)
# DATABASE_URL=sqlite:///./backend/data/nii.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data providers: "mock" works without any key
TRADES_PROVIDER=mock            # mock | house_clerk (metadata only; import trades via CSV)
MARKET_DATA_PROVIDER=mock       # mock | fmp
FUNDAMENTALS_PROVIDER=mock      # mock | fmp
NEWS_PROVIDER=mock

# Optional API keys (never commit real keys)
FMP_API_KEY=

# AI engine: rules (default, deterministic) | anthropic | openai
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Polite fetching for official sources
HTTP_USER_AGENT=NancyInvestmentIntelligence/0.1 (personal research tool; contact: you@example.com)
